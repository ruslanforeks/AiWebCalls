# Скопируйте этот файл в .env и заполните значения.
# .env в git не попадает — он в .gitignore.

# ---- Выбор провайдеров ----

# Кто ведёт разговор и разбирает транскрипт: deepseek | anthropic
LLM_PROVIDER=deepseek

# Кто распознаёт речь: elevenlabs | deepgram
# Deepgram из России не открывается, поэтому по умолчанию elevenlabs.
STT_PROVIDER=elevenlabs

# ---- Ключи ----

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ElevenLabs: распознавание и синтез речи
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Заполнять, только если LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Заполнять, только если STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# ---- Голос ----

# ID голоса из вашей библиотеки ElevenLabs
TTS_VOICE_ID=HcaxAsrhw4ByUo4CBCBN

# flash — самая быстрая модель синтеза; в разговоре скорость важнее тембра
TTS_MODEL=eleven_flash_v2_5

# Потоковое распознавание. Для STT_PROVIDER=deepgram ставьте nova-3-general
STT_MODEL=scribe_v2_realtime

# Настройки голоса. Берутся из его карточки в библиотеке ElevenLabs:
#   curl -H "xi-api-key: $KEY" https://api.elevenlabs.io/v1/voices/{id}/settings
#
# STYLE — выразительность, и это главное. При 0.0 голос звучит ровной
# дикторской начиткой; именно этим демо на сайте отличается от синтеза,
# если настройки не передавать. У Maxim в карточке 0.4.
TTS_STABILITY=0.5
TTS_SIMILARITY=0.75
TTS_STYLE=0.4
TTS_SPEED=1.0
TTS_SPEAKER_BOOST=false

# ---- Модели ----

# В разговоре решает задержка: пауза дольше полутора секунд — и собеседник
# переспрашивает «алло?».
CONVERSATION_MODEL=deepseek-v4-flash

# Разбор транскрипта после звонка. На замерах flash извлекает то же самое,
# что deepseek-v4-pro, но вдвое быстрее. Если на живых звонках качество
# просядет — поменяйте на deepseek-v4-pro.
ANALYSIS_MODEL=deepseek-v4-flash

# ---- Аудиоустройства (только для разговора через микрофон) ----

# Номер устройства или часть названия: «3» либо «AirPods».
# Пусто — системное «по умолчанию». Задавать явно стоит при работе
# с наушниками: система переключает устройство при подключении,
# а PortAudio держит список, снятый на момент запуска.
# Что доступно, покажет: python -m grainvoice.doctor
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Пауза определителя речи. НЕ УВЕЛИЧИВАЙТЕ: за паузы в речи отвечает
# Smart Turn, а он откалиброван под 0.2. При большем значении он ломается
# и агент молчит по три секунды перед каждым ответом.
VAD_STOP_SECS=0.2

# Пауза тишины, после которой распознавание отдаёт финальную расшифровку.
# Меньше — быстрее реакция, но думающего человека обрежет на середине.
STT_SILENCE_SECS=0.5

# Частота вывода. Пусто или 0 — подобрать под устройство, чтобы звук
# нигде не пересчитывался: пересчёт на лету слышен как хрип.
# Буфер: 10 блоков по 10 мс = 100 мс запаса от подвисаний.
AUDIO_OUT_SAMPLE_RATE=0
AUDIO_OUT_CHUNKS_10MS=10

# ---- Поведение агента ----

AGENT_NAME=Алексей
COMPANY_NAME=Зерно-Трейд

# Представляться ли автоматическим помощником.
# false — агент ведёт себя как человек (текущий выбор).
# true — честное раскрытие; понадобится, если у клиента возникнут
# требования юротдела по 152-ФЗ или закону «О рекламе».
DISCLOSE_AI=false

# ---- Версии промптов ----
# Файлы лежат в voice-agent/prompts/. Чтобы попробовать новый сценарий,
# создайте grain_buyer.v2.yaml и поменяйте значение здесь.
CONVERSATION_PROMPT=grain_buyer.v1
ANALYSIS_PROMPT=call_analysis.v1
